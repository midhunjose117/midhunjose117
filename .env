# Global
ENV=local
LOG_LEVEL=INFO

# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# NLP
NLP_HOST=nlp
NLP_PORT=8001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Scheduler
SCHEDULER_HOST=scheduler
SCHEDULER_PORT=8002
MAPS_PROVIDER=none
GOOGLE_MAPS_API_KEY=

# Sync (Nextcloud CalDAV)
SYNC_HOST=sync
SYNC_PORT=8003
NEXTCLOUD_BASE_URL=https://your.nextcloud.example
NEXTCLOUD_USERNAME=
NEXTCLOUD_PASSWORD=
NEXTCLOUD_CALDAV_PATH=/remote.php/dav/calendars/USERNAME/

